# Copy to .env and fill in the connection string. .env is git-ignored and must
# never be committed.
#
# Field names must match the Settings fields in app/config.py exactly:
#   mongo_uri  -> MONGODB_URI
#   mongo_db   -> MONGODB_DB
# A mismatch here fails silently: pydantic-settings ignores an unknown key and
# the app starts with an empty connection string.

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=climate
FRONTEND_ORIGIN=http://localhost:5173
LOGIC_VERSION=v1
PORT=8000